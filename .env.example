# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.
# Never prefix these with NEXT_PUBLIC_ — they must stay on the server.

# Required in production: the code teachers type before generating notes.
# Without it, a production deploy refuses to generate. In development it is only required when set.
LITSKETCH_ACCESS_CODE=

# Required in production. Without it, development runs in sample mode.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Optional: minimal | low | medium | high, or "none" for models without reasoning. Defaults to low.
OPENAI_REASONING_EFFORT=

# Optional: set to 1 to allow sample mode in a production build with no key (for demos only).
LITSKETCH_DEMO=

# Optional, local PDF export only: path to Chrome or Edge if not in a standard location.
CHROME_PATH=
